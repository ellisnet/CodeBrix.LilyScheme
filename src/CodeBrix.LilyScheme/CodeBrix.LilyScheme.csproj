<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.LilyScheme</AssemblyName>
    <RootNamespace>CodeBrix.LilyScheme</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.LilyScheme.LgplLicenseForever</PackageId>
    <Product>CodeBrix.LilyScheme</Product>
    <Title>CodeBrix.LilyScheme</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A limited, managed, cross-platform Scheme language implementation for .NET, derived from the GNU Guile project.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.LilyScheme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.LilyScheme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>scheme;lisp;guile;interpreter;programming-language;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    Vendored Guile Scheme, shipped as embedded resources. These are verbatim copies of
    LGPL-3.0-or-later material from GNU Guile; see THIRD-PARTY-NOTICES.txt for the
    per-file attribution, and note in particular that psyntax-pp.scm carries no
    copyright header of its own and its notice must travel separately.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Scheme\**\*.scm" />
  </ItemGroup>

  <!--
    The Unicode formal-name table, which is what (ice-9 unicode)'s
    char to-formal-name and formal-name to-char answer from. Guile implements
    them over GNU libunistring; there is no managed equivalent, so the names
    ship. Derived from Unicode, Inc.'s UnicodeData.txt by
    tools/unicode-names/generate-unicode-names.py (which has a check mode), and
    recorded in THIRD-PARTY-NOTICES.txt section 6.
    (Note for editors: an XML comment may not contain a double hyphen.)
  -->
  <ItemGroup>
    <EmbeddedResource Include="Unicode\*.deflate"
                      LogicalName="CodeBrix.LilyScheme.Unicode.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <!--
      LGPL-3.0 incorporates the terms of GPL-3.0 by reference, so BOTH license
      texts must travel with the work: a LICENSE carrying only the LGPL-3 text
      is incomplete. PackageLicenseExpression above supplies the SPDX label for
      nuget.org; these two entries put the full texts inside the .nupkg so a
      consumer who never visits the repo can still read the terms and the
      warranty disclaimer. See THIRD-PARTY-NOTICES.txt section 4.2.
    -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.GPL" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
